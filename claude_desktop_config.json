{
  "mcpServers": {
    "conduit": {
      "command": "npx",
      "args": ["conduit-celo"],
      "env": {
        "CELO_RPC_URL": "https://forno.celo.org",
        "PRIVATE_KEY": "your_private_key_here",
        "WALLET_ADDRESS": "your_wallet_address_here",
        "SELF_API_KEY": "your_self_api_key_here"
      }
    }
  }
}
